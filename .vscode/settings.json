{
    "git.ignoreLimitWarning": true,
    "markdown.styles": [
        "assets/styles/custom_markdown.css",
        "assets/styles/custom_classes.css",
        "assets/styles/custom-callouts.css",
        "assets/styles/katex_integration.css"
    ],
    "emeraldwalk.runonsave": {
        "commands": [
            {
                "match": "\\.ipynb$",
                "cmd": "${workspaceFolder}/.venv/bin/jupytext --to py:percent ${file}",
                // "cmd": "jupyter nbconvert --to script ${file}"
            },
            {
                // Run whenever html, css, or js files are saved
                "match": "\\.(html|css|js)$",
                "cmd": "echo '${fileBasename}' saved."
            }
        ]
    },
    "chat.mcp.serverSampling": {
        "gpu_accelerated/.vscode/mcp.json: markitdown": {
            "allowedModels": [
                "copilot/gemini-2.5-pro",
                "copilot/gpt-5-mini",
                "copilot/o3-mini"
            ]
        }
    },
    "markdown.extension.toc.orderedList": false,
    "markdown.extension.toc.levels": "1..6",
    "markdown.extension.toc.updateOnSave": true,
    "markdown.extension.toc.emoji": true,
    "markdown.extension.toc.plaintext": false,
    "chat.instructionsFilesLocations": {
        ".github/instructions/*": true
    },
    "inlineChat.enableV2": true,
    "chat.edits2.enabled": true,
    "github.copilot.chat.reviewSelection.instructions": [
        {
            "file": ".github/instructions/00_project_overview.instructions.md",
        }
    ],
    // "prettier.proseWrap": "never",
    "editor.wordWrapColumn": 80,
    "workbench.editor.wrapTabs": true,
    "markdown.math.macros": {
        "\\RR": "\\mathbb{R}",
        "\\NN": "\\mathbb{N}",
        "\\ZZ": "\\mathbb{Z}",
        "\\QQ": "\\mathbb{Q}",
        "\\CC": "\\mathbb{C}",
        "\\inf": "\\text{inf}",
        "\\sup": "\\text{sup}"
    },
    "markdown.math.enabled": true,
    "mermaid.theme": "neutral",
    "mermaid.gantt.barHeight": 20,
    "mermaid.flowchart.htmlLabels": true,
    "mermaid.vscode.light": "base",
    "mermaid.vscode.dark": "neo-dark",
    "mermaidChart.aiVendor": "copilot",
    "github.copilot.chat.claudeSonnet45AlternatePrompt": "You're an expert software architect, you know everything about design patters, engineering and architechting full solutions solutions, with correct selection of system design and design patterns. You know cupy, numpy and always follow the instructions, prioritizing process over speed.",
    "github.copilot.chat.responsesApiReasoningEffort": "high",
    // "notebook.output.wordWrap": false,
    // "html.format.wrapAttributes": "preserve-aligned",
    // "html.format.wrapLineLength": 0echo "no, I don't
}